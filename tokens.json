{
  "version": "0.3.1",
  "description": "Alfred local design system. Keys map to --alfred-<key> CSS properties. Base defines foundations; themes override semantic roles. This is a simple portable JSON format, not a DTCG compatibility claim.",
  "base": {
    "ivory": "#F4F0E8",
    "paper": "#FBF9F5",
    "charcoal": "#252422",
    "red-decorative": "#C84436",
    "cloud": "#F5F5F7",
    "serif": "Georgia, \"Times New Roman\", serif",
    "sans": "Arial, Helvetica, sans-serif",
    "type-small": "0.875rem",
    "type-body": "1rem",
    "type-title": "clamp(2rem, 4vw, 3.5rem)",
    "type-display": "clamp(2.8rem, 6vw, 6rem)",
    "leading-body": "1.6",
    "leading-heading": "1.05",
    "measure": "65ch",
    "radius-sm": "0.5rem",
    "radius-md": "1rem",
    "radius-lg": "1.5rem",
    "radius-pill": "999px",
    "motion-fast": "120ms",
    "motion-normal": "240ms",
    "motion-ease": "cubic-bezier(0.2, 0, 0, 1)",
    "control-height": "44px",
    "icon-size": "1.25rem",
    "focus-width": "0.2rem",
    "focus-offset": "0.2rem",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-6": "1.5rem",
    "space-8": "2rem",
    "space-12": "3rem",
    "space-16": "4rem",
    "space-24": "6rem"
  },
  "themes": {
    "light": {
      "canvas": "#F4F0E8",
      "surface": "#FBF9F5",
      "surface-2": "#EAE3D8",
      "text": "#252422",
      "muted": "#696159",
      "border": "#81776B",
      "divider": "#D9D0C4",
      "accent": "#252422",
      "on-accent": "#FBF9F5",
      "accent-hover": "#403D39",
      "focus": "#245D8C",
      "success": "#365A43",
      "warning": "#785114",
      "danger": "#AA3429",
      "shadow": "0 1rem 3rem color-mix(in oklch, var(--alfred-text) 10%, transparent)"
    },
    "dark": {
      "canvas": "#252422",
      "surface": "#302E2B",
      "surface-2": "#3C3833",
      "text": "#F4F0E8",
      "muted": "#C3B9AD",
      "border": "#A79B8D",
      "divider": "#57504A",
      "accent": "#F4F0E8",
      "on-accent": "#252422",
      "accent-hover": "#DED5C8",
      "focus": "#8DBDE8",
      "success": "#A3C3AA",
      "warning": "#E2BB7B",
      "danger": "#F39A8D",
      "shadow": "0 1rem 3rem color-mix(in oklch, var(--alfred-canvas) 45%, transparent)"
    }
  }
}
