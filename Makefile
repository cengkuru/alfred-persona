.PHONY: check
check:
	@python3 -c 'from pathlib import Path; import re; r=Path("."); expected={".nojekyll","ALFRED.md","README.md","index.html","tokens.css","Makefile","alfred-concept-reference.png","alfred-full-body.png","alfred-avatar.png","alfred-mood-board.png"}; assert {p.name for p in r.iterdir() if p.name not in {".git"}}==expected,"manifest mismatch"; files=[r/n for n in ["ALFRED.md","README.md","index.html","tokens.css"]]; text="\n".join(p.read_text() for p in files); forbidden=re.compile(r"(?:<<<<<<<|=======|>>>>>>>|(?:/Users/|[A-Za-z]:\\)|(?:api[_-]?key|secret|access[_-]?token)\s*=)",re.I); assert not forbidden.search(text),"conflict, path, or secret assignment"; assert forbidden.search("/Users/private/x") and forbidden.search("API_KEY=x"),"privacy detector regression"; html=(r/"index.html").read_text(); md=(r/"README.md").read_text(); css=(r/"tokens.css").read_text(); local=(set(re.findall(r"(?:href|src)=[\"\x27]([^\"\x27#?]+)",html))|set(re.findall(r"!\[[^]]*\]\(([^)#?]+)",md)))-{x for x in set() if x}; local={x for x in local if not x.startswith(("http://","https://","#"))}; assert all((r/x).exists() for x in local),f"missing local ref: {local}"; assert "Read https://raw.githubusercontent.com/cengkuru/alfred-persona/main/ALFRED.md and use Alfred’s persona" in html and "Read https://raw.githubusercontent.com/cengkuru/alfred-persona/main/ALFRED.md and use Alfred’s persona" in md,"launch prompt"; assert "overflow-wrap:anywhere" in css and "font-size:clamp" in css,"mobile/css guard"; assert all(p.read_bytes()[:8]==b"\x89PNG\r\n\x1a\n" for p in r.glob("*.png")); assert (r/"alfred-full-body.png").read_bytes()[25]==6,"full figure needs RGBA"; print("alfred-persona check: manifest, refs, privacy negatives, launch prompt, CSS, and PNG signatures passed")'
