.PHONY: check
check:
	@python3 -c 'from pathlib import Path; import re; r=Path("."); expected={".nojekyll","ALFRED.md","README.md","index.html","tokens.css","Makefile","ASSETS.md","ONTOLOGY.md","SCENARIOS.md","CHANGELOG.md","alfred-concept-reference.png","alfred-full-body.png","alfred-avatar.png","alfred-mood-board.png"}; assert {p.name for p in r.iterdir() if p.name not in {".git"}}==expected,"manifest mismatch"; text="\n".join(p.read_text() for p in r.glob("*.md"))+(r/"index.html").read_text()+(r/"tokens.css").read_text(); bad=re.compile(r"(?:<<<<<<<|=======|>>>>>>>|(?:/Users/|[A-Za-z]:\\)|(?:api[_-]?key|secret|access[_-]?token)\s*=)",re.I); assert not bad.search(text); assert bad.search("/Users/private/x") and bad.search("API_KEY=x"); html=(r/"index.html").read_text(); links=set(re.findall(r"(?:href|src)=[\"\x27]([^\"\x27#?]+)",html))|set(re.findall(r"!?\[[^]]*\]\(([^)#?]+)",text)); links={x for x in links if not x.startswith(("http://","https://","#"))}; assert all((r/x).exists() for x in links),links; assert "Read https://raw.githubusercontent.com/cengkuru/alfred-persona/main/ALFRED.md and use Alfred’s persona" in html; assert all(p.read_bytes()[:8]==b"\x89PNG\r\n\x1a\n" for p in r.glob("*.png")) and (r/"alfred-full-body.png").read_bytes()[25]==6; print("alfred-persona check: 14-file manifest, refs, privacy negatives, and PNG signatures passed")'
